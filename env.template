# Storage Configuration
# Options: 'azure' for Azure Blob Storage, 'local' for local file system
STORAGE_TYPE=local

# Azure Storage Configuration (only needed if STORAGE_TYPE=azure)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=your_container_name

# Local Storage Configuration (only needed if STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_URL=http://localhost:8000/files

# Azure Form Recognizer (Document Intelligence)
AZURE_FORM_RECOGNIZER_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_KEY=your_form_recognizer_key

# Azure OpenAI Configuration
AZURE_OPENAI_SERVICE=your_openai_service_name
AZURE_OPENAI_API_KEY=your_openai_api_key
AZURE_OPENAI_DEPLOYMENT_NAME=your_gpt4_deployment_name

# OCR Processing Configuration
MAX_PAGES=100
OCR_TIMEOUT=300
PDF_ZOOM=5
IMAGE_DPI=300
CLEANUP_TEMP=true

# AI Vision Configuration
AI_VISION_ENABLED=true
AI_VISION_MIN_FIGURE_SIZE=0.01
AI_VISION_MIN_CAPTION_LENGTH=0
AI_VISION_MAX_FIGURES_PER_DOC=10
AI_VISION_REQUIRED_KEYWORDS=
AI_VISION_EXCLUDED_KEYWORDS=logo,signature,watermark,header,footer
AI_VISION_ANALYZE_TYPES=chart,graph,diagram,table,figure
AI_VISION_SKIP_TYPES=logo,signature,header,footer,watermark

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false

# Bronze Storage Configuration (optional override)
BRONZE_BASE_PATH=bronze 

# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./database/documents.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/documents_db
# For MySQL: DATABASE_URL=mysql://user:password@localhost/documents_db